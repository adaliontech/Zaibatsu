{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.15.0/schemas/factory-improvement-candidate.schema.json",
  "title": "Zaibatsu evidence-bound non-executable improvement candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_schema", "schema_version", "source", "candidate", "binding_checks", "binding_boundary", "factory_improvement_candidate_sha256"],
  "properties": {
    "contract_schema": {"const": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.15.0/schemas/factory-improvement-candidate.schema.json"},
    "schema_version": {"const": "zaibatsu.factory-improvement-candidate.v1"},
    "source": {"$ref": "#/$defs/source"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "binding_checks": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/check_classification"},
        {"$ref": "#/$defs/check_target"},
        {"$ref": "#/$defs/check_artifact"},
        {"$ref": "#/$defs/check_requirements"},
        {"$ref": "#/$defs/check_authority"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "binding_boundary": {"$ref": "#/$defs/binding_boundary"},
    "factory_improvement_candidate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "operation"],
      "properties": {
        "kind": {"enum": ["shared_module", "factory_template", "deterministic_gate"]},
        "id": {"$ref": "#/$defs/id"},
        "operation": {"enum": ["add", "modify", "replace"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_specification_sha256", "candidate_artifact_sha256", "factory_improvement_classification_sha256", "factory_improvement_proposal_sha256", "factory_improvement_observation_sha256", "factory_evidence_return_sha256", "reporting_factory", "control_factory"],
      "properties": {
        "candidate_specification_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "factory_improvement_classification_sha256": {"$ref": "#/$defs/sha256"},
        "factory_improvement_proposal_sha256": {"$ref": "#/$defs/sha256"},
        "factory_improvement_observation_sha256": {"$ref": "#/$defs/sha256"},
        "factory_evidence_return_sha256": {"$ref": "#/$defs/sha256"},
        "reporting_factory": {"$ref": "#/$defs/id"},
        "control_factory": {"$ref": "#/$defs/id"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "artifact_id", "artifact_type", "artifact_sha256", "artifact_canonical_bytes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/target"},
        "artifact_id": {"$ref": "#/$defs/id"},
        "artifact_type": {"enum": ["shared_module_contract", "factory_template_contract", "deterministic_gate_contract"]},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_canonical_bytes": {"type": "integer", "minimum": 1, "maximum": 524288}
      }
    },
    "check_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "id", "status", "reason"],
      "properties": {
        "position": {"const": 0},
        "id": {"const": "classification_eligible"},
        "status": {"const": "passed"},
        "reason": {"const": "classification_is_eligible_for_validation_planning"}
      }
    },
    "check_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "id", "status", "reason"],
      "properties": {
        "position": {"const": 1},
        "id": {"const": "target_aligned"},
        "status": {"const": "passed"},
        "reason": {"const": "candidate_target_matches_classification_target"}
      }
    },
    "check_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "id", "status", "reason"],
      "properties": {
        "position": {"const": 2},
        "id": {"const": "artifact_structurally_valid"},
        "status": {"const": "passed"},
        "reason": {"const": "candidate_contract_structure_is_valid"}
      }
    },
    "check_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "id", "status", "reason"],
      "properties": {
        "position": {"const": 3},
        "id": {"const": "review_requirements_preserved"},
        "status": {"const": "passed"},
        "reason": {"const": "all_later_review_requirements_preserved"}
      }
    },
    "check_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "id", "status", "reason"],
      "properties": {
        "position": {"const": 4},
        "id": {"const": "non_authorizing_candidate"},
        "status": {"const": "passed"},
        "reason": {"const": "candidate_contract_grants_no_authority"}
      }
    },
    "binding_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification_chain_reverified", "candidate_specification_validated", "candidate_artifact_structurally_validated", "candidate_target_aligned", "candidate_artifact_canonical_json_bound", "candidate_artifact_bound", "content_safety_scanned", "secret_absence_proved", "artifact_semantic_truth_verified", "candidate_implementation_present", "validation_plan_created", "validation_execution_authorized", "reporting_factory_validation_passed", "independent_regression_validation_passed", "rollback_plan_verified", "owner_policy_approval_obtained", "changes_shared_policy", "shared_promotion_eligible", "promotion_authorized", "rollout_authorized", "activation_authorized", "execution_authorized", "cross_factory_effects_authorized"],
      "properties": {
        "classification_chain_reverified": {"const": true},
        "candidate_specification_validated": {"const": true},
        "candidate_artifact_structurally_validated": {"const": true},
        "candidate_target_aligned": {"const": true},
        "candidate_artifact_canonical_json_bound": {"const": true},
        "candidate_artifact_bound": {"const": true},
        "content_safety_scanned": {"const": false},
        "secret_absence_proved": {"const": false},
        "artifact_semantic_truth_verified": {"const": false},
        "candidate_implementation_present": {"const": false},
        "validation_plan_created": {"const": false},
        "validation_execution_authorized": {"const": false},
        "reporting_factory_validation_passed": {"const": false},
        "independent_regression_validation_passed": {"const": false},
        "rollback_plan_verified": {"const": false},
        "owner_policy_approval_obtained": {"const": false},
        "changes_shared_policy": {"const": false},
        "shared_promotion_eligible": {"const": false},
        "promotion_authorized": {"const": false},
        "rollout_authorized": {"const": false},
        "activation_authorized": {"const": false},
        "execution_authorized": {"const": false},
        "cross_factory_effects_authorized": {"const": false}
      }
    }
  }
}
