{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.9.0/schemas/runtime-evidence-verifier-registry.schema.json",
  "title": "Zaibatsu runtime evidence verifier registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_schema", "schema_version", "registry_id", "signature_namespace", "verifiers", "registry_boundary", "verifier_registry_sha256"],
  "properties": {
    "contract_schema": {"const": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.9.0/schemas/runtime-evidence-verifier-registry.schema.json"},
    "schema_version": {"const": "zaibatsu.runtime-evidence-verifier-registry.v1"},
    "registry_id": {"$ref": "#/$defs/slug"},
    "signature_namespace": {"const": "zaibatsu-runtime-evidence-v1"},
    "verifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/verifier"}
    },
    "registry_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_keys_only", "private_keys_included", "exact_allowlists_required", "signatures_required", "self_attestation_accepted", "signature_grants_runtime_eligibility", "signature_grants_activation", "signature_grants_execution"],
      "properties": {
        "public_keys_only": {"const": true},
        "private_keys_included": {"const": false},
        "exact_allowlists_required": {"const": true},
        "signatures_required": {"const": true},
        "self_attestation_accepted": {"const": false},
        "signature_grants_runtime_eligibility": {"const": false},
        "signature_grants_activation": {"const": false},
        "signature_grants_execution": {"const": false}
      }
    },
    "verifier_registry_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "requirement": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "stringSet": {"type": "array", "minItems": 1, "uniqueItems": true},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "verifier_id", "public_key", "implementation_sha256", "allowed_factories", "allowed_scopes", "allowed_requirements", "allowed_methods", "max_validity_seconds", "trust_role", "active"],
      "properties": {
        "position": {"type": "integer", "minimum": 0, "maximum": 63},
        "verifier_id": {"$ref": "#/$defs/slug"},
        "public_key": {"type": "string", "pattern": "^ssh-ed25519 [A-Za-z0-9+/]+={0,2}$"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "allowed_factories": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"type": "array", "items": {"$ref": "#/$defs/slug"}}]},
        "allowed_scopes": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"type": "array", "items": {"enum": ["factory_runtime", "public_test_fixture"]}}]},
        "allowed_requirements": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"type": "array", "items": {"$ref": "#/$defs/requirement"}}]},
        "allowed_methods": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"type": "array", "items": {"$ref": "#/$defs/requirement"}}]},
        "max_validity_seconds": {"type": "integer", "minimum": 60, "maximum": 2678400},
        "trust_role": {"$ref": "#/$defs/slug"},
        "active": {"const": true}
      }
    }
  }
}
