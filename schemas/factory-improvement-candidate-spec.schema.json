{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.15.0/schemas/factory-improvement-candidate-spec.schema.json",
  "title": "Zaibatsu untrusted improvement-candidate contract specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_schema", "schema_version", "candidate", "binding_requirements", "candidate_boundary"],
  "properties": {
    "contract_schema": {"const": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.15.0/schemas/factory-improvement-candidate-spec.schema.json"},
    "schema_version": {"const": "zaibatsu.factory-improvement-candidate-spec.v1"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "artifact"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "summary": {"$ref": "#/$defs/text"},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "binding_requirements": {"$ref": "#/$defs/binding_requirements"},
    "candidate_boundary": {"$ref": "#/$defs/candidate_boundary"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "operation"],
      "properties": {
        "kind": {"enum": ["shared_module", "factory_template", "deterministic_gate"]},
        "id": {"$ref": "#/$defs/id"},
        "operation": {"enum": ["add", "modify", "replace"]}
      }
    },
    "behavior_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "id", "description"],
      "properties": {
        "position": {"type": "integer", "minimum": 0, "maximum": 31},
        "id": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/text"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"target": {"type": "object", "properties": {"kind": {"const": "shared_module"}}}}},
          "then": {"properties": {"artifact_type": {"const": "shared_module_contract"}}}
        },
        {
          "if": {"properties": {"target": {"type": "object", "properties": {"kind": {"const": "factory_template"}}}}},
          "then": {"properties": {"artifact_type": {"const": "factory_template_contract"}}}
        },
        {
          "if": {"properties": {"target": {"type": "object", "properties": {"kind": {"const": "deterministic_gate"}}}}},
          "then": {"properties": {"artifact_type": {"const": "deterministic_gate_contract"}}}
        }
      ],
      "required": ["artifact_id", "artifact_type", "target", "interface", "behavior", "authority_boundary"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "artifact_type": {"enum": ["shared_module_contract", "factory_template_contract", "deterministic_gate_contract"]},
        "target": {"$ref": "#/$defs/target"},
        "interface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_contract", "output_contract", "deterministic"],
          "properties": {
            "input_contract": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "output_contract": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "deterministic": {"const": true}
          }
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "checks", "failure_mode"],
          "properties": {
            "summary": {"$ref": "#/$defs/text"},
            "checks": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/behavior_check"}},
            "failure_mode": {"const": "deny"}
          }
        },
        "authority_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract_only", "contains_executable_implementation", "reads_secrets", "invokes_models", "mutates_state", "executes_operations", "grants_authority"],
          "properties": {
            "contract_only": {"const": true},
            "contains_executable_implementation": {"const": false},
            "reads_secrets": {"const": false},
            "invokes_models": {"const": false},
            "mutates_state": {"const": false},
            "executes_operations": {"const": false},
            "grants_authority": {"const": false}
          }
        }
      }
    },
    "binding_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification_reverification_required", "target_alignment_required", "canonical_artifact_required", "content_safety_required_before_validation_execution", "semantic_validation_required_before_promotion", "reporting_factory_regression_required", "independent_regression_required", "rollback_required", "owner_policy_approval_required", "cross_factory_privilege_review_required"],
      "properties": {
        "classification_reverification_required": {"const": true},
        "target_alignment_required": {"const": true},
        "canonical_artifact_required": {"const": true},
        "content_safety_required_before_validation_execution": {"const": true},
        "semantic_validation_required_before_promotion": {"const": true},
        "reporting_factory_regression_required": {"const": true},
        "independent_regression_required": {"const": true},
        "rollback_required": {"const": true},
        "owner_policy_approval_required": {"const": true},
        "cross_factory_privilege_review_required": {"const": true}
      }
    },
    "candidate_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_artifact_untrusted", "contains_candidate_contract", "content_safety_scanned", "secret_absence_proved", "artifact_semantic_truth_verified", "candidate_implementation_present", "validation_plan_created", "validation_execution_authorized", "reporting_factory_validation_passed", "independent_regression_validation_passed", "rollback_plan_verified", "owner_policy_approval_obtained", "shared_promotion_eligible", "promotion_authorized", "rollout_authorized", "activation_authorized", "execution_authorized", "cross_factory_effects_authorized"],
      "properties": {
        "candidate_artifact_untrusted": {"const": true},
        "contains_candidate_contract": {"const": true},
        "content_safety_scanned": {"const": false},
        "secret_absence_proved": {"const": false},
        "artifact_semantic_truth_verified": {"const": false},
        "candidate_implementation_present": {"const": false},
        "validation_plan_created": {"const": false},
        "validation_execution_authorized": {"const": false},
        "reporting_factory_validation_passed": {"const": false},
        "independent_regression_validation_passed": {"const": false},
        "rollback_plan_verified": {"const": false},
        "owner_policy_approval_obtained": {"const": false},
        "shared_promotion_eligible": {"const": false},
        "promotion_authorized": {"const": false},
        "rollout_authorized": {"const": false},
        "activation_authorized": {"const": false},
        "execution_authorized": {"const": false},
        "cross_factory_effects_authorized": {"const": false}
      }
    }
  }
}
