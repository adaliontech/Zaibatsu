{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.11.0/schemas/factory-portfolio.schema.json",
  "title": "Zaibatsu closed software-factory portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_schema", "schema_version", "portfolio", "factories", "evidence_routes", "policies"],
  "properties": {
    "contract_schema": {"const": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.11.0/schemas/factory-portfolio.schema.json"},
    "schema_version": {"const": "zaibatsu.factory-portfolio.v1"},
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "control_factory"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
        "control_factory": {"$ref": "#/$defs/id"}
      }
    },
    "factories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "properties": {"class": {"const": "control_factory"}},
        "required": ["class"]
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position", "id", "class"],
        "properties": {
          "position": {"type": "integer", "minimum": 0, "maximum": 63},
          "id": {"$ref": "#/$defs/id"},
          "class": {"enum": ["control_factory", "economic_factory"]}
        }
      }
    },
    "evidence_routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 63,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_route"}
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed_registry", "unknown_factories_fail_closed", "one_control_factory", "factory_scoped_authority", "factory_scoped_secrets", "factory_scoped_workers", "factory_scoped_artifacts", "evidence_only_cross_factory_routes", "cross_factory_route_grants_authority", "factory_may_self_promote", "plan_executes_operations"],
      "properties": {
        "closed_registry": {"const": true},
        "unknown_factories_fail_closed": {"const": true},
        "one_control_factory": {"const": true},
        "factory_scoped_authority": {"const": true},
        "factory_scoped_secrets": {"const": true},
        "factory_scoped_workers": {"const": true},
        "factory_scoped_artifacts": {"const": true},
        "evidence_only_cross_factory_routes": {"const": true},
        "cross_factory_route_grants_authority": {"const": false},
        "factory_may_self_promote": {"const": false},
        "plan_executes_operations": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "evidence_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "from_factory", "to_factory", "kind", "payload_scope", "grants_authority", "can_self_promote"],
      "properties": {
        "position": {"type": "integer", "minimum": 0, "maximum": 62},
        "from_factory": {"$ref": "#/$defs/id"},
        "to_factory": {"$ref": "#/$defs/id"},
        "kind": {"const": "evidence_return"},
        "payload_scope": {"const": "evidence_only"},
        "grants_authority": {"const": false},
        "can_self_promote": {"const": false}
      }
    }
  }
}
