{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.3.0/schemas/module-artifact.schema.json",
  "title": "Zaibatsu portable module contract artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_schema", "schema_version", "module_api_version", "artifact_kind", "id", "slot", "kind", "implementation_status", "policy_value", "description", "rebuild_boundary", "requires_slots", "provides", "side_effect_authority", "runtime"],
  "properties": {
    "contract_schema": {"const": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.3.0/schemas/module-artifact.schema.json"},
    "schema_version": {"const": "zaibatsu.module-artifact.v1"},
    "module_api_version": {"const": "zaibatsu.module.v1"},
    "artifact_kind": {"const": "module_contract"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "slot": {"enum": ["source_versioning", "static_secrets", "runtime_secrets", "host_reproduction", "worker_environment", "scheduling", "execution", "verification", "feedback"]},
    "kind": {"enum": ["deterministic", "probabilistic_adapter"]},
    "implementation_status": {"enum": ["contract_only", "source_only", "planned"]},
    "policy_value": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "description": {"type": "string", "minLength": 1},
    "rebuild_boundary": {"type": "string", "minLength": 1},
    "requires_slots": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "provides": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "side_effect_authority": {"const": false},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_included", "entrypoint", "environment_lock_included", "deploys_infrastructure"],
      "properties": {
        "implementation_included": {"const": false},
        "entrypoint": {"type": "null"},
        "environment_lock_included": {"const": false},
        "deploys_infrastructure": {"const": false}
      }
    }
  }
}
