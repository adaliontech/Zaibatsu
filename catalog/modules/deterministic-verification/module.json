{
  "contract_schema": "https://raw.githubusercontent.com/adaliontech/Zaibatsu/v1.3.0/schemas/module-artifact.schema.json",
  "schema_version": "zaibatsu.module-artifact.v1",
  "module_api_version": "zaibatsu.module.v1",
  "artifact_kind": "module_contract",
  "id": "deterministic-verification",
  "slot": "verification",
  "kind": "deterministic",
