  "rebuild_boundary": "artifact_acceptance",
  "requires_slots": ["execution"],
  "provides": ["verification_result", "policy_decision", "effect_eligibility"],
  "side_effect_authority": false,
  "runtime": {
    "implementation_included": false,
    "entrypoint": null,
    "environment_lock_included": false,
    "deploys_infrastructure": false
  }
